---
import Layout from '../layouts/Layout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import { destinationsData } from '../data/destinations';
---

<Layout
  title="Uganda National Parks & Wildlife Sanctuaries"
  description="Explore the great wilderness ecosystems of Uganda: Bwindi Impenetrable Forest, Queen Elizabeth & Ishasha, Kibale Primate Forest, Murchison Falls, and remote Kidepo Valley."
>

  <!-- Hero Header -->
  <section class="bg-[#0e231b] text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-30">
      <img
        src="https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?auto=format&fit=crop&w=2000&q=80"
        alt="Ugandan savanna scenery"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-block px-3 py-1 text-[11px] font-semibold tracking-wider uppercase bg-[#16382c] text-[#dfb674] rounded border border-[#c89b53]/30">
        Albertine Rift & Savanna Sanctuaries
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold leading-tight">
        Protected Ecosystems of Uganda
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#ded6c4] font-light leading-relaxed">
        Where ancient Pleistocene rainforests meet the Great East African Rift and the legendary headwaters of the Nile. Discover each protected territory's wildlife, elevation, and premier luxury eco-lodges.
      </p>
    </div>
  </section>

  <!-- Destination Cards Directory -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {destinationsData.map((dest, idx) => (
        <div class="fade-in-view">
          <DestinationCard destination={dest} index={idx + 1} />
        </div>
      ))}
    </div>

    <!-- Safari Planning Assistance Banner -->
    <div class="mt-20 bg-[#122e23] text-white rounded-xl p-8 md:p-12 border border-[#23533f] shadow-xl text-center space-y-6 fade-in-view">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#dfb674]">
        Circuit Architecture
      </span>
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold">
        How to Combine These Wilderness Reserves
      </h2>
      <p class="max-w-2xl mx-auto text-xs sm:text-sm text-[#ded6c4] leading-relaxed">
        Because Uganda is geographically compact, our overland routes link misty mountain rainforests with expansive lion savanna in just 3 to 4 hours of scenic driving through tea estates and crater lake ridges. Private scheduled bush flights are also available to connect Entebbe directly to Kidepo Valley and Bwindi.
      </p>
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/safaris"
          class="px-8 py-3.5 text-xs font-semibold uppercase tracking-wider text-[#0e231b] bg-[#c89b53] hover:bg-[#d8af6e] rounded transition-colors shadow"
        >
          View Safari Itineraries
        </a>
        <a
          href="/contact"
          class="px-8 py-3.5 text-xs font-semibold uppercase tracking-wider text-white bg-[#1c4435] hover:bg-[#255b47] rounded border border-[#c89b53]/40 transition-colors"
        >
          Request Custom Route Plan
        </a>
      </div>
    </div>
  </section>

</Layout>

