---
import Layout from '../layouts/Layout.astro';
import { trustHighlights } from '../data/company';

const teamMembers = [
  {
    name: "Moses Mukasa",
    role: "Co-Founder & Lead Primate Naturalist",
    certification: "USAGA Gold Certified Naturalist",
    bio: "Raised along the misty edges of Bwindi Forest, Moses has spent over 18 years tracking habituated mountain gorilla families and eastern chimpanzees. He has trained dozens of park rangers and is widely recognized for his encyclopedic understanding of Albertine Rift primate behavior.",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Grace Kiconco",
    role: "Head of Safari Operations & Lodge Relations",
    certification: "Tourism Management, Makerere University",
    bio: "Grace manages our operations desks in Kampala and Entebbe. With over 12 years coordinating complex safari logistics, luxury aviation charters, and exclusive lodge buyouts, she ensures every permit, transfer, and flight connection is executed without error.",
    image: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Patrick Byarugaba",
    role: "Senior Ornithologist & Photographic Specialist",
    certification: "USAGA Silver Level Birder & Nature Photographer",
    bio: "Patrick is one of East Africa's most acclaimed birding guides, having personally logged 984 of Uganda's 1,060 recorded bird species. Photographers rely on his uncanny ability to position 4x4 vehicles for optimal natural light angles.",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80"
  }
];
---

<Layout
  title="About Demo Safaris Uganda & Demonstration Showcase"
  description="Meet Demo Safaris Uganda: a professional touring website demonstration showcasing custom 4x4 Land Cruiser fleet specifications, licensed guides, and AMREF safety protocols."
>

  <!-- Hero Header -->
  <section class="bg-[#0e231b] text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-25">
      <img
        src="https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=2000&q=80"
        alt="East African landscape"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-block px-3 py-1 text-[11px] font-semibold tracking-wider uppercase bg-[#16382c] text-[#dfb674] rounded border border-[#c89b53]/30">
        Demonstration Portfolio Showcase
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold leading-tight">
        Born in Uganda, Guided by Science
      </h1>
      <p class="max-w-3xl mx-auto text-sm sm:text-base text-[#ded6c4] font-light leading-relaxed">
        Demo Safaris Uganda was created as a high-end showcase of what an authentic, conservation-focused touring website should be: private, unhurried, scientifically grounded expeditions across the Albertine Rift.
      </p>
    </div>
  </section>

  <!-- Section 1: The Guild Story & Credentials -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-6 space-y-6 fade-in-view">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block">
          Showcase Concept
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#14261f]">
          Excellence in Conservation Travel
        </h2>
        <p class="text-xs sm:text-sm text-[#544e45] leading-relaxed">
          Demo Safaris Uganda was conceptualized with a singular objective: to demonstrate how a modern outfitter platform can connect travelers with Uganda's extraordinary biodiversity through the eyes of career local naturalists who consider these forests and savannas their home.
        </p>
        <p class="text-xs sm:text-sm text-[#544e45] leading-relaxed">
          This demo showcases end-to-end safari logistics: custom long-wheelbase 4x4 Land Cruisers, priority permit coordination models with the Uganda Wildlife Authority, and career naturalist guiding.
        </p>

        <div class="pt-2 border-t border-[#ded7c8] space-y-2 text-xs text-[#14261f]">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Uganda Tourism Board Outfitter License: UTB/L-TO/2018/00482</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Association of Uganda Tour Operators: Full Member No. 418</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Uganda Wildlife Authority Official Permit Partner</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 fade-in-view fade-in-delay-1">
        <div class="relative rounded-xl overflow-hidden border border-[#dcd6c8] shadow-xl">
          <img
            src="https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?auto=format&fit=crop&w=1200&q=80"
            alt="Lead safari naturalist in the field"
            class="w-full h-full object-cover"
          />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-6 text-white">
            <span class="text-xs uppercase font-bold text-[#dfb674] tracking-wider block">Field Integrity</span>
            <p class="text-xs text-[#ded6c4] mt-1">Our naturalists are certified by the Uganda Safari Guides Association.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Section 2: Fleet Specifications & Mechanical Rigor -->
  <section class="bg-[#f3efe6] py-20 border-y border-[#ded7c8]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-2xl mx-auto fade-in-view">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block mb-2">
          Expedition Vehicles
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[#14261f]">
          Custom 4x4 Safari Land Cruisers
        </h2>
        <p class="mt-3 text-sm text-[#615a4f]">
          Built specifically to handle Uganda's red-clay mountain passes and remote savanna terrain without sacrificing comfort.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="bg-white p-6 rounded-lg border border-[#ded7c8] shadow-sm space-y-2 fade-in-view">
          <h4 class="font-serif text-lg font-bold text-[#14261f]">Pop-Up Photographic Roof</h4>
          <p class="text-xs text-[#544e45] leading-relaxed">
            Full-length hydraulic roof raises easily for unobstructed 360-degree game viewing and bird photography with beanbag support mounts.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-[#ded7c8] shadow-sm space-y-2 fade-in-view fade-in-delay-1">
          <h4 class="font-serif text-lg font-bold text-[#14261f]">Guaranteed Window Seating</h4>
          <p class="text-xs text-[#544e45] leading-relaxed">
            Every passenger is guaranteed an individual window seat with personal armrests, reading lamps, and direct window hatch access.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-[#ded7c8] shadow-sm space-y-2 fade-in-view fade-in-delay-2">
          <h4 class="font-serif text-lg font-bold text-[#14261f]">Inverter Power Onboard</h4>
          <p class="text-xs text-[#544e45] leading-relaxed">
            Multiple 220V power outlets and USB fast-charge ports allow continuous camera battery and phone charging during game drives.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-[#ded7c8] shadow-sm space-y-2 fade-in-view fade-in-delay-3">
          <h4 class="font-serif text-lg font-bold text-[#14261f]">Onboard Chiller & Optics</h4>
          <p class="text-xs text-[#544e45] leading-relaxed">
            Fitted with a 40-liter 12V refrigerator for cold refreshments, plus a pair of calibrated Swarovski Optik binoculars for guest use.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Section 3: Aero-Medical Safety & AMREF Flying Doctors -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-[#112d23] text-white rounded-2xl p-8 md:p-14 border border-[#23533f] shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-4 fade-in-view">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#dfb674]">
            Emergency Medical Evacuation
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold leading-tight">
            AMREF Flying Doctors Coverage Included for Every Traveler
          </h2>
          <p class="text-xs sm:text-sm text-[#ded6c4] leading-relaxed">
            Your peace of mind is paramount. Every itinerary conceived by Demo Safaris Uganda is modeled with AMREF Flying Doctors Tourist Scheme air evacuation standards. In the unlikely event of a medical emergency in remote wilderness reserves like Bwindi or Kidepo Valley, a dedicated medical aircraft with trauma doctors is dispatched immediately to airlift you to a top-tier hospital in Nairobi or Kampala.
          </p>
        </div>

        <div class="lg:col-span-4 flex lg:justify-end fade-in-view fade-in-delay-1">
          <div class="p-6 rounded-xl bg-[#183c2e] border border-[#2e6950] text-center w-full max-w-xs space-y-2">
            <span class="text-xs uppercase font-bold text-[#dfb674] tracking-wider block">Comprehensive Coverage</span>
            <span class="font-serif text-3xl font-bold text-white block">24 / 7</span>
            <span class="text-xs text-[#ded6c4] block">Aero-Medical Evacuation across all remote national parks in Uganda.</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 4: Senior Naturalist Team Profiles -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 fade-in-view">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block mb-2">
        Field Leadership
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[#14261f]">
        Meet Our Lead Naturalists
      </h2>
      <p class="mt-3 text-sm text-[#615a4f]">
        Our guides are mentors, historians, and conservationists with decades of combined tracking experience.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {teamMembers.map((member) => (
        <div class="bg-white rounded-xl overflow-hidden border border-[#ded7c8] shadow-sm flex flex-col justify-between fade-in-view">
          <div>
            <div class="relative aspect-4/3 overflow-hidden bg-[#162a22]">
              <img
                src={member.image}
                alt={member.name}
                class="w-full h-full object-cover img-luxury-zoom"
              />
            </div>
            <div class="p-6 space-y-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#c89b53] block">
                {member.certification}
              </span>
              <h3 class="font-serif text-xl font-bold text-[#14261f]">
                {member.name}
              </h3>
              <p class="text-xs text-[#8a7f6f] font-medium pb-2">
                {member.role}
              </p>
              <p class="text-xs text-[#544e45] leading-relaxed pt-2 border-t border-[#f0ede6]">
                {member.bio}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

</Layout>

