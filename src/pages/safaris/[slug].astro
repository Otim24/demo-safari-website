---
import Layout from '../../layouts/Layout.astro';
import SafariCard from '../../components/SafariCard.astro';
import { safarisData, type SafariPackage } from '../../data/safaris';

export async function getStaticPaths() {
  return safarisData.map((safari) => ({
    params: { slug: safari.slug },
    props: { safari },
  }));
}

interface Props {
  safari: SafariPackage;
}

const { safari } = Astro.props;
const otherSafaris = safarisData.filter((s) => s.id !== safari.id).slice(0, 2);
---

<Layout
  title={`${safari.title} (${safari.durationDays} Days)`}
  description={safari.tagline}
  image={safari.heroImage}
>

  <!-- Hero Banner -->
  <section class="relative min-h-[60vh] flex items-end bg-[#091711] overflow-hidden pb-16 pt-32">
    <div class="absolute inset-0 z-0">
      <img
        src={safari.heroImage}
        alt={safari.title}
        class="w-full h-full object-cover object-center brightness-[0.55]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0e231b] via-[#091711]/60 to-black/40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white w-full">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center space-x-2 text-xs text-[#ded6c4] mb-4">
        <a href="/" class="hover:text-[#c89b53] transition-colors">Home</a>
        <span>/</span>
        <a href="/safaris" class="hover:text-[#c89b53] transition-colors">Safaris</a>
        <span>/</span>
        <span class="text-[#c89b53] font-medium">{safari.category}</span>
      </nav>

      <div class="inline-block px-3 py-1 text-[11px] font-semibold tracking-wider uppercase bg-[#16382c]/80 text-[#dfb674] rounded border border-[#c89b53]/30 mb-3">
        {safari.category} • {safari.groupType}
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold leading-tight max-w-4xl text-[#faf8f5]">
        {safari.title}
      </h1>

      <p class="mt-4 max-w-3xl text-sm sm:text-base text-[#ded6c4] font-light leading-relaxed">
        {safari.tagline}
      </p>

      <!-- Meta Strip -->
      <div class="mt-8 pt-6 border-t border-[#294c3d]/60 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl">
        <div>
          <span class="text-[10px] text-[#a99e89] uppercase tracking-wider block">Duration</span>
          <span class="font-serif text-lg font-bold text-white">{safari.durationDays} Days / {safari.durationNights} Nights</span>
        </div>
        <div>
          <span class="text-[10px] text-[#a99e89] uppercase tracking-wider block">Private From</span>
          <span class="font-serif text-lg font-bold text-[#dfb674]">${safari.priceFromUSD.toLocaleString()} / person</span>
        </div>
        <div>
          <span class="text-[10px] text-[#a99e89] uppercase tracking-wider block">Physical Demand</span>
          <span class="font-serif text-lg font-bold text-white">{safari.physicalDemand}</span>
        </div>
        <div>
          <span class="text-[10px] text-[#a99e89] uppercase tracking-wider block">Vehicle Standard</span>
          <span class="font-serif text-lg font-bold text-white">Custom 4x4 Land Cruiser</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Sticky In-Page Navigation Strip -->
  <div class="sticky top-20 z-30 bg-[#f7f5ef] border-b border-[#ded7c8] py-3 px-4 sm:px-6 hidden sm:block">
    <div class="max-w-7xl mx-auto flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-[#544e45]">
      <div class="flex items-center space-x-8">
        <a href="#overview" class="hover:text-[#c89b53] transition-colors">Expedition Overview</a>
        <a href="#highlights" class="hover:text-[#c89b53] transition-colors">Key Highlights</a>
        <a href="#itinerary" class="hover:text-[#c89b53] transition-colors">Day-by-Day Route</a>
        <a href="#inclusions" class="hover:text-[#c89b53] transition-colors">Inclusions</a>
      </div>
      <a
        href="#inquire"
        class="px-4 py-1.5 bg-[#c89b53] text-[#0e231b] rounded font-bold hover:bg-[#d8af6e] transition-colors"
      >
        Inquire for This Safari
      </a>
    </div>
  </div>

  <!-- Main Content Layout -->
  <div class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-8 space-y-16">
        
        <!-- Overview Section -->
        <section id="overview" class="space-y-4 fade-in-view">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block">
            Detailed Overview
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#14261f]">
            About This Expedition
          </h2>
          <p class="text-sm sm:text-base text-[#544e45] leading-relaxed">
            {safari.overview}
          </p>

          <div class="pt-4 p-5 rounded-lg bg-[#f3efe6] border border-[#e5dfd2]">
            <h4 class="font-serif text-base font-bold text-[#14261f] mb-1">
              Best Season for This Route
            </h4>
            <p class="text-xs sm:text-sm text-[#615a4f]">
              {safari.bestSeason}
            </p>
          </div>
        </section>

        <!-- Highlights Section -->
        <section id="highlights" class="space-y-6 fade-in-view">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block">
            Curated Highlights
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#14261f]">
            What Makes This Journey Unrivaled
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {safari.highlights.map((highlight) => (
              <div class="flex items-start space-x-3 p-4 rounded bg-white border border-[#e5dfd2]">
                <div class="w-5 h-5 rounded-full bg-[#142c22] text-[#c89b53] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-xs sm:text-sm text-[#453f35] leading-snug">{highlight}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Day by Day Itinerary Section -->
        <section id="itinerary" class="space-y-8 fade-in-view">
          <div class="flex items-end justify-between border-b border-[#e5dfd2] pb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block mb-1">
                Day-by-Day Narrative
              </span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#14261f]">
                Detailed Expedition Plan
              </h2>
            </div>
            <span class="text-xs text-[#8c8273] font-medium hidden sm:block">
              {safari.itinerary.length} Days Planned
            </span>
          </div>

          <div class="space-y-6">
            {safari.itinerary.map((day) => (
              <div class="bg-white rounded-lg border border-[#e5dfd2] p-6 shadow-sm hover:border-[#c89b53]/50 transition-colors">
                <div class="flex items-center space-x-3 mb-3">
                  <span class="px-2.5 py-1 text-xs font-bold uppercase tracking-wider bg-[#142c22] text-[#dfb674] rounded">
                    Day {day.day}
                  </span>
                  <h3 class="font-serif text-lg sm:text-xl font-bold text-[#14261f]">
                    {day.title}
                  </h3>
                </div>

                <p class="text-xs sm:text-sm text-[#544e45] leading-relaxed mb-4">
                  {day.description}
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t border-[#f3efe6] text-xs">
                  <div>
                    <span class="text-[#8c8273] block uppercase text-[10px] tracking-wider font-semibold">Accommodation:</span>
                    <span class="font-medium text-[#14261f]">{day.accommodation}</span>
                  </div>
                  <div>
                    <span class="text-[#8c8273] block uppercase text-[10px] tracking-wider font-semibold">Meal Plan:</span>
                    <span class="font-medium text-[#14261f]">{day.mealPlan}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Inclusions & Exclusions Section -->
        <section id="inclusions" class="space-y-8 fade-in-view">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block mb-1">
              Transparent Details
            </span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#14261f]">
              Inclusions & Exclusions
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Inclusions -->
            <div class="bg-white p-6 rounded-lg border border-[#c4dccb]">
              <h4 class="font-serif text-lg font-bold text-[#142c22] mb-4 flex items-center space-x-2">
                <svg class="w-5 h-5 text-[#2c7744]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Included on This Expedition:</span>
              </h4>
              <ul class="space-y-3 text-xs sm:text-sm text-[#4d473e]">
                {safari.inclusions.map((item) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-[#2c7744] font-bold mt-0.5">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Exclusions -->
            <div class="bg-white p-6 rounded-lg border border-[#e5dfd2]">
              <h4 class="font-serif text-lg font-bold text-[#453f35] mb-4 flex items-center space-x-2">
                <svg class="w-5 h-5 text-[#9e9483]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Excluded:</span>
              </h4>
              <ul class="space-y-3 text-xs sm:text-sm text-[#544e45]">
                {safari.exclusions.map((item) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-[#9e9483] font-bold mt-0.5">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

      </div>

      <!-- Right Sidebar (Sticky Inquiry & Direct Contact) -->
      <aside class="lg:col-span-4 space-y-8">
        
        <!-- Inquiry Card -->
        <div id="inquire" class="sticky top-32 bg-white rounded-xl border border-[#dcd6c8] p-6 shadow-lg space-y-6">
          <div class="border-b border-[#f0ede6] pb-4">
            <span class="text-[10px] text-[#8c8273] uppercase tracking-wider block">Private Expedition Guidance</span>
            <span class="font-serif text-2xl font-bold text-[#14261f] block mt-1">
              ${safari.priceFromUSD.toLocaleString()}
              <span class="text-xs font-normal text-[#6b6457]">/ guest</span>
            </span>
            <span class="text-xs text-[#8c8273] block mt-1">Tier: Luxury Eco-Lodges & Tented Camps</span>
          </div>

          <!-- Quick Inquiry Form -->
          <form class="space-y-4" action="/contact" method="GET">
            <input type="hidden" name="safari" value={safari.title} />

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#544e45] mb-1">
                Your Full Name
              </label>
              <input
                type="text"
                required
                placeholder="e.g. Dr. Arthur Conan"
                class="w-full text-xs text-[#1b1917] bg-[#f9f7f3] border border-[#dcd6c8] rounded px-3 py-2.5 focus:outline-none focus:border-[#c89b53]"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#544e45] mb-1">
                Email Address
              </label>
              <input
                type="email"
                required
                placeholder="arthur@example.com"
                class="w-full text-xs text-[#1b1917] bg-[#f9f7f3] border border-[#dcd6c8] rounded px-3 py-2.5 focus:outline-none focus:border-[#c89b53]"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-[#544e45] mb-1">
                  Estimated Dates
                </label>
                <input
                  type="text"
                  placeholder="e.g. Aug 2026"
                  class="w-full text-xs text-[#1b1917] bg-[#f9f7f3] border border-[#dcd6c8] rounded px-3 py-2.5 focus:outline-none focus:border-[#c89b53]"
                />
              </div>
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-[#544e45] mb-1">
                  Travelers
                </label>
                <select class="w-full text-xs text-[#1b1917] bg-[#f9f7f3] border border-[#dcd6c8] rounded px-3 py-2.5 focus:outline-none focus:border-[#c89b53]">
                  <option>2 Guests</option>
                  <option>1 Solo</option>
                  <option>3 to 4 Guests</option>
                  <option>5+ Family Group</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-[#544e45] mb-1">
                Custom Requirements
              </label>
              <textarea
                rows="3"
                placeholder="Permit preferences, photographic focus, dietary needs..."
                class="w-full text-xs text-[#1b1917] bg-[#f9f7f3] border border-[#dcd6c8] rounded px-3 py-2 focus:outline-none focus:border-[#c89b53]"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 text-xs font-semibold tracking-wider uppercase text-[#0e231b] bg-[#c89b53] hover:bg-[#d8af6e] rounded text-center transition-colors shadow"
            >
              Inquire for This Expedition
            </button>
          </form>

          <div class="border-t border-[#f0ede6] pt-4 space-y-3">
            <a
              href="https://wa.me/256784811929"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-3 text-xs font-medium text-[#14261f] bg-[#f3efe6] hover:bg-[#ded7c8] rounded text-center flex items-center justify-center space-x-2 transition-colors"
            >
              <svg class="w-4 h-4 text-[#2b724c]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.101.005.245-.038.384.296.144.346.491 1.2.534 1.287.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.303c-.087.101-.178.21-.077.383.101.173.45 1.488 1.433 2.364.382.34.704.457.946.554.218.087.378.077.518-.087.144-.173.607-.707.768-.953.159-.246.318-.202.534-.116.217.087 1.373.647 1.609.764.236.116.393.173.45.275.058.101.058.592-.086.997z"/>
              </svg>
              <span>Instant WhatsApp Concierge</span>
            </a>

            <div class="text-[11px] text-[#8c8273] space-y-1">
              <p class="flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Direct UWA Permit Allocation</span>
              </p>
              <p class="flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>AMREF Flying Doctors Coverage Included</span>
              </p>
              <p class="flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>100% Private 4x4 Land Cruiser Guarantee</span>
              </p>
            </div>
          </div>
        </div>

      </aside>

    </div>
  </div>

  <!-- Related Expeditions Section -->
  <section class="py-16 bg-[#f3efe6] border-t border-[#ded7c8]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#c89b53] block mb-1">
            Other Journeys
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#14261f]">
            You May Also Consider
          </h2>
        </div>
        <a href="/safaris" class="text-xs font-semibold uppercase tracking-wider text-[#14261f] hover:text-[#c89b53] transition-colors">
          View All Safaris &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {otherSafaris.map((item) => (
          <SafariCard safari={item} />
        ))}
      </div>
    </div>
  </section>

</Layout>

