---
import type { SafariPackage } from '../data/safaris';

interface Props {
  safari: SafariPackage;
  featured?: boolean;
}

const { safari, featured = false } = Astro.props;
---

<article class={`group bg-white rounded-lg overflow-hidden border border-[#e8e2d5] hover:border-[#c89b53]/60 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col ${featured ? 'md:col-span-2 lg:col-span-1' : ''}`}>
  
  <!-- Image Container -->
  <div class="relative aspect-16/10 overflow-hidden bg-[#162a22]">
    <img
      src={safari.heroImage}
      alt={safari.title}
      loading="lazy"
      class="w-full h-full object-cover img-luxury-zoom brightness-[0.93] group-hover:brightness-100 transition-all duration-700"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    
    <!-- Category Badge -->
    <div class="absolute top-3 left-3">
      <span class="inline-block px-3 py-1 text-[11px] font-semibold tracking-wider uppercase bg-[#0e231b]/85 backdrop-blur-sm text-[#e8c999] rounded border border-[#c89b53]/30">
        {safari.category}
      </span>
    </div>

    <!-- Duration Pill -->
    <div class="absolute top-3 right-3">
      <span class="inline-flex items-center space-x-1 px-2.5 py-1 text-[11px] font-medium tracking-wide bg-black/60 backdrop-blur-sm text-white rounded">
        <svg class="w-3.5 h-3.5 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{safari.durationDays} Days / {safari.durationNights} Nights</span>
      </span>
    </div>

    <!-- Title and Subtitle Overlay on Bottom of Image -->
    <div class="absolute bottom-3 inset-x-3 text-white">
      <p class="text-xs text-[#d6cdb7] tracking-wider uppercase font-medium">
        {safari.groupType}
      </p>
    </div>
  </div>

  <!-- Content Container -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div>
      <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#14261f] group-hover:text-[#946b2b] transition-colors leading-snug mb-2">
        <a href={`/safaris/${safari.slug}`}>
          {safari.title}
        </a>
      </h3>

      <p class="text-xs sm:text-sm text-[#544e45] leading-relaxed line-clamp-3">
        {safari.overview}
      </p>

      <!-- Key Destinations Chips -->
      <div class="mt-4 flex flex-wrap gap-1.5">
        {safari.destinations.slice(0, 4).map((dest) => (
          <span class="text-[11px] bg-[#f5f2eb] text-[#4d483f] px-2.5 py-0.5 rounded border border-[#e5dfd2]">
            {dest}
          </span>
        ))}
        {safari.destinations.length > 4 && (
          <span class="text-[11px] bg-[#f5f2eb] text-[#827a6f] px-2 py-0.5 rounded border border-[#e5dfd2]">
            +{safari.destinations.length - 4} more
          </span>
        )}
      </div>
    </div>

    <!-- Highlights Snippet -->
    <div class="border-t border-[#f0ede6] pt-4 space-y-2 text-xs text-[#524d44]">
      <div class="flex items-start space-x-2">
        <svg class="w-4 h-4 text-[#c89b53] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="line-clamp-1">{safari.highlights[0]}</span>
      </div>
      <div class="flex items-start space-x-2">
        <svg class="w-4 h-4 text-[#c89b53] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="line-clamp-1">{safari.highlights[1]}</span>
      </div>
    </div>

    <!-- Pricing and Action Footer -->
    <div class="border-t border-[#f0ede6] pt-4 flex items-center justify-between">
      <div>
        <span class="text-[10px] text-[#857d71] uppercase tracking-wider block">Private Rate From</span>
        <span class="font-serif text-lg sm:text-xl font-bold text-[#14261f]">
          ${safari.priceFromUSD.toLocaleString()}
          <span class="text-xs font-normal text-[#6b6457]">/ person</span>
        </span>
      </div>

      <a
        href={`/safaris/${safari.slug}`}
        class="inline-flex items-center space-x-1.5 px-4 py-2 text-xs font-semibold tracking-wider text-white uppercase bg-[#142c22] hover:bg-[#c89b53] hover:text-[#0e231b] transition-all duration-300 rounded"
      >
        <span>Itinerary</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>

</article>

