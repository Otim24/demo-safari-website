---
import type { Destination } from '../data/destinations';

interface Props {
  destination: Destination;
  index?: number;
}

const { destination, index = 1 } = Astro.props;
---

<a
  href={`/destinations/${destination.slug}`}
  class="group relative h-[440px] rounded-2xl overflow-hidden block shadow-lg hover:shadow-2xl transition-all duration-500 border border-[#234d3d]/20 hover:border-[#c89b53]/80 bg-[#0e231b]"
>
  <!-- Full-Bleed Background Image -->
  <img
    src={destination.heroImage}
    alt={destination.name}
    loading="lazy"
    class="absolute inset-0 w-full h-full object-cover object-center img-luxury-zoom brightness-[0.82] group-hover:brightness-95 group-hover:scale-105 transition-all duration-700 ease-out"
  />

  <!-- Cinematic Multi-Layer Gradient Overlays -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#081510] via-[#081510]/55 to-black/30 group-hover:via-[#081510]/40 transition-all duration-500"></div>

  <!-- Top Metadata Bar -->
  <div class="absolute top-4 inset-x-4 flex items-center justify-between z-10">
    <span class="inline-flex items-center text-[11px] font-semibold tracking-wider uppercase text-[#dfb674] bg-black/50 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
      {destination.region.split(',')[0]}
    </span>
    <span class="inline-flex items-center text-[10px] font-medium tracking-wide text-white/90 bg-black/40 backdrop-blur-md px-2.5 py-1 rounded-full border border-white/10">
      {destination.areaKm2}
    </span>
  </div>

  <!-- Bottom Content Container -->
  <div class="absolute bottom-0 inset-x-0 p-6 z-10 flex flex-col justify-end space-y-3">
    
    <!-- Index Number & Region -->
    <div class="flex items-center space-x-2 text-[11px] font-mono tracking-widest text-[#c89b53] uppercase">
      <span>0{index}</span>
      <span class="text-white/40">/</span>
      <span class="tracking-wider">{destination.recommendedStay}</span>
    </div>

    <!-- Park Name -->
    <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white group-hover:text-[#dfb674] transition-colors duration-300 leading-tight">
      {destination.name}
    </h3>

    <!-- Crisp Summary (1 concise sentence) -->
    <p class="text-xs text-[#ded6c4] leading-relaxed line-clamp-2">
      {destination.summary}
    </p>

    <!-- Key Wildlife Tags & Action Strip -->
    <div class="pt-2 border-t border-white/15 flex items-center justify-between">
      <div class="flex flex-wrap gap-1.5">
        {destination.keyWildlife.slice(0, 2).map((animal) => (
          <span class="text-[10px] text-[#e8c999] bg-white/10 backdrop-blur-sm px-2 py-0.5 rounded border border-white/10">
            {animal.split('(')[0].trim()}
          </span>
        ))}
      </div>

      <span class="inline-flex items-center space-x-1 text-xs font-semibold uppercase tracking-wider text-[#dfb674] group-hover:text-white transition-colors duration-300 shrink-0 ml-2">
        <span>Explore</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </div>

    <!-- Bottom Accent Hover Line -->
    <div class="w-0 group-hover:w-full h-0.5 bg-[#c89b53] transition-all duration-500 ease-out"></div>

  </div>
</a>
