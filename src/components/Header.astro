---
import { companyData } from '../data/company';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home', number: '01' },
  { href: '/safaris', label: 'Safaris & Expeditions', shortLabel: 'Safaris', number: '02' },
  { href: '/gorilla-trekking', label: 'Gorilla Trekking', shortLabel: 'Gorilla Trekking', number: '03' },
  { href: '/destinations', label: 'National Parks', shortLabel: 'National Parks', number: '04' },
  { href: '/safari-calculator', label: 'Cost Estimator', shortLabel: 'Cost Estimator', number: '05' },
  { href: '/conservation', label: 'Conservation', shortLabel: 'Conservation', number: '06' },
  { href: '/about', label: 'About Us', shortLabel: 'About', number: '07' },
];
---

<!-- Top Authority Bar (Desktop & Laptops) -->
<div class="bg-[#081510] text-[#b8ad96] text-[11px] py-2 px-4 border-b border-[#163327] hidden lg:block">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <span class="tracking-wider uppercase font-medium text-[#c89b53]">
        Portfolio Showcase
      </span>
      <span class="text-[#1f4736]">•</span>
      <span class="text-[#ded6c4]">
        Uganda Wildlife Expeditions Demonstration Platform
      </span>
    </div>
    
    <div class="flex items-center space-x-6">
      <a href="tel:+256784811929" class="hover:text-[#c89b53] transition-colors flex items-center space-x-1.5">
        <svg class="w-3.5 h-3.5 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>+256 784 811 929</span>
      </a>
      <span class="text-[#1f4736]">•</span>
      <a href="https://wa.me/256784811929" target="_blank" rel="noopener noreferrer" class="hover:text-[#c89b53] transition-colors flex items-center space-x-1.5">
        <svg class="w-3.5 h-3.5 text-[#c89b53]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.101.005.245-.038.384.296.144.346.491 1.2.534 1.287.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.303c-.087.101-.178.21-.077.383.101.173.45 1.488 1.433 2.364.382.34.704.457.946.554.218.087.378.077.518-.087.144-.173.607-.707.768-.953.159-.246.318-.202.534-.116.217.087 1.373.647 1.609.764.236.116.393.173.45.275.058.101.058.592-.086.997z"/>
        </svg>
        <span>WhatsApp Concierge</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header Bar -->
<header class="sticky top-0 z-40 bg-[#0a1b14]/95 backdrop-blur-md border-b border-[#18362a] transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo Lockup -->
      <a href="/" class="flex items-center space-x-3.5 group shrink-0">
        <div class="w-10 h-10 rounded bg-[#132c21] border border-[#c89b53]/40 flex items-center justify-center p-2 group-hover:border-[#c89b53] transition-colors duration-300 shadow-sm">
          <svg class="w-6 h-6 text-[#c89b53]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v18m0-18l-8 8m8-8l8 8M4 11l8 8 8-8" />
            <circle cx="12" cy="12" r="3" stroke-width="1.5" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-wider text-[#faf8f5] uppercase group-hover:text-[#dfb674] transition-colors leading-none">
            Demo Safaris
          </span>
          <span class="text-[9px] sm:text-[10px] tracking-[0.25em] text-[#c89b53] uppercase font-semibold mt-1">
            Uganda Expeditions
          </span>
        </div>
      </a>

      <!-- Desktop Navigation (Visible on xl / 1280px+ for Generous Breathing Room) -->
      <nav class="hidden xl:flex items-center space-x-8">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-[13px] tracking-wide font-medium transition-colors duration-200 py-1 border-b-2 whitespace-nowrap ${
                isActive
                  ? 'text-[#dfb674] border-[#c89b53]'
                  : 'text-[#e2dac7] border-transparent hover:text-[#dfb674] hover:border-[#c89b53]/50'
              }`}
            >
              {link.shortLabel || link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Action CTA -->
      <div class="hidden xl:flex items-center space-x-4 shrink-0">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold tracking-wider text-[#0e231b] uppercase bg-[#c89b53] hover:bg-[#d8af6e] transition-colors duration-300 rounded shadow-md"
        >
          Plan Safari
        </a>
      </div>

      <!-- Tablet & Mobile Header Trigger Controls -->
      <div class="flex xl:hidden items-center space-x-3">
        <a
          href="/contact"
          class="hidden sm:inline-flex px-3.5 py-1.5 text-xs font-semibold tracking-wider text-[#0e231b] uppercase bg-[#c89b53] hover:bg-[#d8af6e] rounded shadow transition-colors"
        >
          Plan Safari
        </a>
        
        <button
          type="button"
          id="mobile-drawer-trigger"
          class="flex items-center space-x-2 px-3 py-2 rounded-lg bg-[#142c22] border border-[#234d3d] text-[#ded6c4] hover:text-white hover:border-[#c89b53] transition-all focus:outline-none"
          aria-label="Open menu navigation"
          aria-expanded="false"
        >
          <span class="text-xs font-semibold tracking-wider uppercase hidden md:inline-block">Menu</span>
          <svg class="w-5 h-5 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Mobile & Tablet Slide-Over Sheet Overlay (Backdrop) -->
<div
  id="drawer-backdrop"
  class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 transition-opacity duration-400 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Mobile & Tablet Slide-Over Sheet Drawer (Slides in from Right) -->
<aside
  id="drawer-panel"
  class="fixed inset-y-0 right-0 z-50 w-full sm:w-[420px] max-w-full bg-[#081510] border-l border-[#1b3d30] shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-y-auto"
  aria-label="Mobile and tablet navigation"
>
  
  <!-- Drawer Header -->
  <div class="p-6 border-b border-[#18362a] flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded bg-[#132c21] border border-[#c89b53]/40 flex items-center justify-center p-1.5">
        <svg class="w-5 h-5 text-[#c89b53]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v18m0-18l-8 8m8-8l8 8M4 11l8 8 8-8" />
          <circle cx="12" cy="12" r="3" stroke-width="1.5" />
        </svg>
      </div>
      <div>
        <span class="font-serif text-lg font-bold tracking-wider text-white uppercase block leading-none">
          Demo Safaris
        </span>
        <span class="text-[9px] tracking-[0.2em] text-[#c89b53] uppercase font-semibold">
          Uganda Expeditions
        </span>
      </div>
    </div>

    <!-- Close Button -->
    <button
      type="button"
      id="drawer-close-btn"
      class="p-2 rounded-lg text-[#ded6c4] hover:text-white hover:bg-[#132c21] transition-colors focus:outline-none"
      aria-label="Close navigation menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Navigation Links Body -->
  <div class="px-6 py-6 flex-1 space-y-2">
    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#8a7f6f] block mb-3">
      Expedition Navigation
    </span>

    <nav class="space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`group flex items-center justify-between py-3.5 px-3 rounded-lg transition-all duration-200 ${
              isActive
                ? 'bg-[#142c22] text-[#dfb674]'
                : 'text-[#ded6c4] hover:bg-[#11261d] hover:text-white'
            }`}
          >
            <div class="flex items-center space-x-3.5">
              <span class="font-mono text-xs text-[#c89b53]/80 group-hover:text-[#c89b53]">
                {link.number}
              </span>
              <span class="font-serif text-lg font-semibold tracking-wide">
                {link.label}
              </span>
            </div>

            <svg class="w-4 h-4 text-[#8a7f6f] group-hover:text-[#dfb674] transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Drawer Footer Actions -->
  <div class="p-6 border-t border-[#18362a] bg-[#06120d] space-y-4">
    <a
      href="/contact"
      class="w-full inline-flex items-center justify-center py-3.5 px-5 text-xs font-semibold uppercase tracking-wider text-[#0e231b] bg-[#c89b53] hover:bg-[#d8af6e] rounded text-center transition-colors shadow-md"
    >
      Plan Bespoke Safari Proposal
    </a>

    <div class="grid grid-cols-2 gap-2 text-xs">
      <a
        href="https://wa.me/256784811929"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center space-x-2 py-2.5 px-3 bg-[#132c21] hover:bg-[#1a3d2e] text-[#ded6c4] rounded border border-[#234d3d] transition-colors"
      >
        <svg class="w-4 h-4 text-[#2b724c]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.101.005.245-.038.384.296.144.346.491 1.2.534 1.287.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.303c-.087.101-.178.21-.077.383.101.173.45 1.488 1.433 2.364.382.34.704.457.946.554.218.087.378.077.518-.087.144-.173.607-.707.768-.953.159-.246.318-.202.534-.116.217.087 1.373.647 1.609.764.236.116.393.173.45.275.058.101.058.592-.086.997z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <a
        href="tel:+256784811929"
        class="flex items-center justify-center space-x-2 py-2.5 px-3 bg-[#132c21] hover:bg-[#1a3d2e] text-[#ded6c4] rounded border border-[#234d3d] transition-colors"
      >
        <svg class="w-4 h-4 text-[#c89b53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Guide</span>
      </a>
    </div>

    <div class="text-[11px] text-[#8a7f6f] pt-2 text-center">
      <span>Demonstration Showcase • +256 784 811 929</span>
    </div>
  </div>

</aside>

<script>
  function setupDrawer() {
    const triggerBtn = document.getElementById('mobile-drawer-trigger');
    const closeBtn = document.getElementById('drawer-close-btn');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');

    if (!triggerBtn || !closeBtn || !backdrop || !panel) return;

    function openDrawer() {
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      triggerBtn.setAttribute('aria-expanded', 'true');
    }

    function closeDrawer() {
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      triggerBtn.setAttribute('aria-expanded', 'false');
    }

    triggerBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    // Escape key closes drawer
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });

    // Close when clicking any nav link inside drawer
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });
  }

  setupDrawer();
  document.addEventListener('astro:page-load', setupDrawer);
</script>
