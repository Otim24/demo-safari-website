---
// Client-side observer for fade-in animations on scroll
---

<script>
  function setupScrollReveals() {
    const targets = document.querySelectorAll('.fade-in-view:not(.is-visible)');
    if (!targets.length) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      targets.forEach(target => observer.observe(target));
    } else {
      // Fallback for older browsers
      targets.forEach(target => target.classList.add('is-visible'));
    }
  }

  // Run on initial load and on Astro view transitions
  setupScrollReveals();
  document.addEventListener('astro:page-load', setupScrollReveals);
</script>

